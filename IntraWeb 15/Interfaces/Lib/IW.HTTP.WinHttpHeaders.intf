type
  {$EXTERNALSYM HINTERNET}
  HINTERNET = Pointer;
  {$EXTERNALSYM INTERNET_PORT}
  INTERNET_PORT = Word; //Integer;

  {$EXTERNALSYM PWinHttpCurrentUser_IEProxyConfig}
  PWinHttpCurrentUser_IEProxyConfig = ^TWinHttpCurrentUser_IEProxyConfig;
  {$EXTERNALSYM _WINHTTP_CURRENT_USER_IE_PROXY_CONFIG}
  _WINHTTP_CURRENT_USER_IE_PROXY_CONFIG = record
    fAutoDetect: Boolean;
    lpszAutoConfigUrl: PWideChar;
    lpszProxy: PWideChar;
    lpszProxyBypass: PWideChar;
  end;
  {$EXTERNALSYM TWinHttpCurrentUser_IEProxyConfig}
  TWinHttpCurrentUser_IEProxyConfig = _WINHTTP_CURRENT_USER_IE_PROXY_CONFIG;

  {$EXTERNALSYM TInternetScheme}
  TInternetScheme = (
    INTERNET_SCHEME_DEFAULT = 0,
    INTERNET_SCHEME_FTP = 1,
    INTERNET_SCHEME_GOPHER = 2,
    INTERNET_SCHEME_HTTP = 3,
    INTERNET_SCHEME_HTTPS = 4,
    INTERNET_SCHEME_SOCKS = 5,
    INTERNET_SCHEME_FIRST = INTERNET_SCHEME_FTP,
    INTERNET_SCHEME_LAST = INTERNET_SCHEME_SOCKS
  );

  {$EXTERNALSYM PURLComponents}
  PURLComponents = ^TURLComponents;
  {$EXTERNALSYM TURLComponents}
  TURLComponents = record
    dwStructSize: DWORD;
    lpszScheme: LPWSTR;
    dwSchemeLength: DWORD;
    nScheme: Integer;
    lpszHostName: LPWSTR;
    dwHostNameLength: DWORD;
    nPort: INTERNET_PORT;       // no padding here, and no packed record
    lpszUserName: LPWSTR;
    dwUserNameLength: DWORD;
    lpszPassword: LPWSTR;
    dwPasswordLength: DWORD;
    lpszUrlPath: LPWSTR;
    dwUrlPathLength: DWORD;
    lpszExtraInfo: LPWSTR;
    dwExtraInfoLength: DWORD;
  end;

var
  {$EXTERNALSYM WinHttpGetIEProxyConfigForCurrentUser}
  WinHttpGetIEProxyConfigForCurrentUser: function(
    out pProxyConfig: TWinHttpCurrentUser_IEProxyConfig): BOOL; stdcall;

  {$EXTERNALSYM WinHttpOpen}
  WinHttpOpen: function(
    pwszUserAgent: PWideChar;
    dwAccessType: DWORD;
    pwszProxyName: PWideChar;
    pwszProxyBypass: PWideChar;
    dwFlags: DWORD): HINTERNET; stdcall;

  {$EXTERNALSYM WinHttpConnect}
  WinHttpConnect: function(
    hSession: HINTERNET;
    pswzServerName: PWideChar;
    nServerPort: INTERNET_PORT;
    dwReserved: DWORD): HINTERNET; stdcall;

  {$EXTERNALSYM WinHttpOpenRequest}
  WinHttpOpenRequest: function(
    hConnect: HINTERNET;
    pwszVerb: PWideChar;
    pwszObjectName: PWideChar;
    pwszVersion: PWideChar;
    pwszReferrer: PWideChar;
    ppwszAcceptTypes: PLPWSTR;
    dwFlags: DWORD): HINTERNET; stdcall;

  {$EXTERNALSYM WinHttpAddRequestHeaders}
  WinHttpAddRequestHeaders: function(
    hRequest: HINTERNET;
    pwszHeaders: PWideChar;
    dwHeadersLength: DWORD;
    dwModifiers: DWORD): BOOL; stdcall;

  {$EXTERNALSYM WinHttpSendRequest}
  WinHttpSendRequest: function(
    hRequest: HINTERNET;
    pwszHeaders: PWideChar;
    dwHeadersLength: DWORD;
    lpOptional: Pointer;
    dwOptionalLength: DWORD;
    dwTotalLength: DWORD;
    dwContext: DWORD_PTR): BOOL; stdcall;

  {$EXTERNALSYM WinHttpReceiveResponse}
  WinHttpReceiveResponse: function(
    hRequest: HINTERNET;
    lpReserved: Pointer): BOOL; stdcall;

  {$EXTERNALSYM WinHttpQueryHeaders}
  WinHttpQueryHeaders: function(
    hRequest: HINTERNET;
    dwInfoLevel: DWORD;
    pwszName: PWideChar;
    lpBuffer: Pointer;
    var lpdwBufferLength: DWORD;
    lpdwIndex: PDWORD): BOOL; stdcall;

  {$EXTERNALSYM WinHttpReadData}
  WinHttpReadData: function(
    hRequest: HINTERNET;
    var lpBuffer;
    dwNumberOfBytesToRead: DWORD;
    lpdwNumberOfBytesRead: LPDWORD): BOOL; stdcall;

  {$EXTERNALSYM WinHttpQueryDataAvailable}
  WinHttpQueryDataAvailable: function(
    hRequest: HINTERNET;
    lpdwNumberOfBytesAvailable: LPDWORD): BOOL; stdcall;

  {$EXTERNALSYM WinHttpCloseHandle}
  WinHttpCloseHandle: function(
    hInternet: HINTERNET): BOOL; stdcall;

  {$EXTERNALSYM WinHttpCrackUrl}
  WinHttpCrackUrl: function(
    pwszUrl: PWideChar;
    dwUrlLength: DWORD;
    dwFlags: DWORD;
    var lpUrlComponents: TURLComponents): BOOL; stdcall;

  {$EXTERNALSYM WinHttpSetTimeouts}
  WinHttpSetTimeouts: function(
    hInternet: HINTERNET;
    nResolveTimeout: Integer;
    nConnectTimeout: Integer;
    nSendTimeout: Integer;
    nReceiveTimeout: Integer): BOOL; stdcall;

  {$EXTERNALSYM WinHttpSetOption}
  WinHttpSetOption: function(
    hInternet: HINTERNET;
    dwOption: DWORD;
    lpBuffer: Pointer;
    dwBufferLength: DWORD): BOOL; stdcall;

var
  DLLIsLoaded: Boolean;

implementation
