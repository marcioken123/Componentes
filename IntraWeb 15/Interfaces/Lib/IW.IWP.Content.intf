unit IW.IWP.Content;
{$I IWCompilerDefines.inc}

interface

uses
  Classes, IW.Content.Base, IWApplication, IW.HTTP.Request, IW.HTTP.Reply, IWTag, IW.Common.NativeXML;

type
  TVarType = (vtVar, vtHTML, vtText);

  TContentIWP = class(TContentBase)
  protected
    mRootPath: string;
    mFile: string;
    mEnumListInfo: TStringList;
    //
    procedure MergeStreams(ADest, ASource: TStringStream; StreamType: TVarType);
    procedure ProcessSysTag(aVarName: string; aDest: TStringStream);
    procedure ProcessVarTag(aTag: TIWTag; aDest: TStringStream);
    function ProcessFileTag(aVarName: string; aDest: TStringStream; aFileName: string): Boolean;
    procedure ProcessEnumList(aTag: TIWTag; aDest: TStringStream; aRSSChannel: TXMLNode = Nil; aRequest: THttpRequest = nil);
    procedure ProcessEnumBreadcrumb(ATag: TIWTag; aDest: TStringStream);
    procedure ProcessHttpTag(ATag: TIWTag; aRequest: THttpRequest; aDest: TStringStream);
    procedure ProcessCookieTag(ATag: TIWTag; aRequest: THttpRequest; aDest: TStringStream);
    procedure ProcessDocTag(ATag: TIWTag; aRequest: THttpRequest; aDest: TStringStream);
    procedure ProcessDirTag(ATag: TIWTag; aRequest: THttpRequest; aDest: TStringStream);
    procedure ProcessArgTag(aArgValue: string; aDest: TStringStream);
    function ProcessRSS(aTag: TIWTag; aRequest: THttpRequest; aMaxItems, aPage: string): string;
    procedure EmbedRSSLink(ATag: TIWTag; aDest: TStringStream; aRequest: THttpRequest);
    procedure FixHRefLink(ATag: TIWTag; aDest: TStringStream);
  public
    constructor Create; override;
    destructor Destroy; override;
    function Execute(aRequest: THttpRequest; aReply: THttpReply; const aPathname: string;
      aSession: TIWApplication; aParams: TStrings): Boolean; override;
    function ExecuteRSS(aRequest: THttpRequest): TStream;
    property FileName: string read mFile write mFile;
  end;

implementation
