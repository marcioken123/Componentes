unit IWBaseHTMLInterfaces;
{$I IWCompilerDefines.inc}

interface

uses
  Classes, Graphics,
  IWColor, IWFont, IWHTMLTag, IWRenderContext,
  IWBaseInterfaces, IW.Common.RenderStream;

type
  TIWOnHTMLTag = procedure(ASender: TObject; ATag: TIWHTMLTag) of object;

  // Must be in its own unit. hpp emits interfaces last and TIWControl needs it before it as it
  // uses it.
  //
  // Interfaces have caused numerous problems
  // -No inheritance detection
  // -Freeing component while interface is held cause AV when done with interface or := nil
  //  Not always avoidable, see TIWAppForm.Execute.

  IIWBaseHTMLComponent = interface(IIWBaseComponent)
    ['{2BFCF866-AC0C-4A71-9B58-A816D42FFE44}']
    function get_HTMLName: string;
    function get_OnHTMLTag: TIWOnHTMLTag;
    procedure set_OnHTMLTag(AValue: TIWOnHTMLTag);
    function get_HasName: Boolean;
    function NeedsFormTag: Boolean;
    function RenderHTML(AContext: TIWCompContext): TIWHTMLTag;
    procedure MakeHTMLTag(ATag: TIWHTMLTag; ABuffer: TIWRenderStream); overload;
    function MakeHTMLTag(ATag: TIWHTMLTag): string; overload; // SLOW, for backward compatibility only
    procedure DoHTMLTag(ATag: TIWHTMLTag);
    property HTMLName: string read get_HTMLName;
    property HasName: Boolean read get_HasName;
    property OnHTMLTag: TIWOnHTMLTag read get_OnHTMLTag write set_OnHTMLTag;
  end;

  IIWBaseHTMLControl = interface(IIWBaseHTMLComponent)
    ['{EE586FAD-A475-44A3-8AE4-3F55E583A661}']
    procedure set_WebFont(AValue: TIWFont);
    function get_WebFont: TIWFont;

    procedure set_WebColor(Value: TIWColor);
    function get_WebColor: TIWColor;

    function get_HTMLWidth: Integer;
    function get_HTMLHeight: Integer;

    property WebColor: TIWColor read get_WebColor write set_WebColor;
    property WebFont: TIWFont read get_WebFont write set_WebFont;
    property HTMLWidth: Integer read get_HTMLWidth;
    property HTMLHeight: Integer read get_HTMLHeight;
  end;

  function BaseHTMLControlInterface(AObject: TObject): IIWBaseHTMlControl; overload; {$IFDEF USE_INLINE} inline; {$ENDIF}
  function BaseHTMLControlInterface(AObject: TObject; out AInterface: IIWBaseHTMLControl): Boolean; overload; {$IFDEF USE_INLINE} inline; {$ENDIF}

  function BaseHTMLComponentInterface(AObject: TObject): IIWBaseHTMLComponent; overload;  {$IFDEF USE_INLINE} inline; {$ENDIF}
  function BaseHTMLComponentInterface(AObject: TObject; out AInterface: IIWBaseHTMLComponent): Boolean; overload; {$IFDEF USE_INLINE} inline; {$ENDIF}

implementation
