procedure GetIWColorValues(Proc: TGetStrProc);

function IWColorToString(Color: TIWColor): string;

// overloads required by FPC
function IWColorToIdent(Color: LongInt; var Ident: string): Boolean; overload;

function IWColorToIdent(Color: LongInt; var Ident: AnsiString): Boolean; overload;

function IdentToIWColor(const Ident: string; var Color: LongInt): Boolean; overload;

function IdentToIWColor(const Ident: AnsiString; var Color: Longint): Boolean; overload;

function StringToIWColor(const S: string): TIWColor;

function toTColor(AColor: TIWColor): TColor;

function fromTColor(AColor: TColor): TIWColor;

function HexColorToRGB(const HexColor: string; var R, G, B: Byte): Boolean;

function HexColorToRGBA(const HexColor: string; var R, G, B: Byte; var A: Double): Boolean;

function HexColorToRGBAString(const HexColor: string; aTransparency: Double): string;

function TransparencyToHex(Transparency: Double): string;

function HexToTransparency(const HexTransparency: string): Double;

procedure ColorRGBValues(AColor: TColor; var R, G, B: Byte);

function ColorToRGBString(AColor: TIWColor): string;

function RGBStringToColor(const rgbString: string): TColor;

function ColorToRGBAString(AColor: TIWColor; AColorTransparency: Double): string;

function HTMLColor(AColor: TIWColor; const ATag: string = 'Color'): string;

function IsValidRGBAString(const rgbaString: string): Boolean;

function DecodeRGBAString(const rgbaString: string; var R, G, B: Byte; var A: Double): Boolean;


