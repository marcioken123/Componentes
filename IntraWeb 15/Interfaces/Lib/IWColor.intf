unit IWColor;
{$I IWCompilerDefines.inc}

{Dist Public}

interface

uses
  Windows, Graphics, Classes, SysUtils;

type
  TIWColor = type TColor;

  TIWColorRGBA = class(TPersistent)
  private
    FColor: TIWColor;
    FTransparency: Double;
    function GetAsRGBAString: string;
    procedure SetAsRGBAString(const Value: string);
  published
    property Color: TIWColor read FColor write FColor;
    property Transparency: Double read FTransparency write FTransparency;
    property AsRGBA: string read GetAsRGBAString write SetAsRGBAString;
  end;

