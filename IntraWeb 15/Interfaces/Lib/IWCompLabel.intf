unit IWCompLabel;
{$I IWCompilerDefines.inc}

{PUBDIST}

interface

uses
  Classes,
  IWXMLTag, IWTypes,
  IWControl, IWHTMLTag, IWColor, IWRenderContext, IWMarkupLanguageTag,
  IWHTMLControls;

type
  TIWCustomLabel = class(TIWCustomControl)
  private
    FDisplayStyle: TIWDisplayStyle;
    procedure SetDisplayStyle(const Value: TIWDisplayStyle);
  protected
    FAlignment: TAlignment;
    FRawText: Boolean;
    FNoWrap: Boolean;
    FConvertSpaces: Boolean;
    FForControl: TIWCustomControl;
    FHasTaborder: Boolean;

    procedure SetAutoSize(Value: Boolean); override;
    procedure SetAlignment(const Value: TAlignment);
    procedure SetRawText(Value: Boolean);
    procedure InitControl; override;
    procedure SetBGColor(Value: TIWColor);
    function GetBGColor : TIWColor;
    function RenderAsync(AContext: TIWCompContext): TIWXMLTag; override;
    procedure SetHasTabOrder(const Value: Boolean);
    function  get_ShouldRenderTabOrder: Boolean; override;

    procedure RenderLabelText(AParentTag: TIWMarkupLanguageTag);
    procedure SetForControl(const Value: TIWCustomControl);
    function get_HasName: Boolean; override;
  public
    //Todo: This should *not* be public in TIWCustomControl 
    function get_HasTabOrder: Boolean; override;
    function RenderHTML(AContext: TIWCompContext): TIWHTMLTag; override;
    function RenderStyle(AComponentContext: TIWCompContext): string; override;

    property AutoSize default True;
    property RawText: Boolean read FRawText write SetRawText;
    property WebFont;
    property DisplayStyle: TIWDisplayStyle read FDisplayStyle write SetDisplayStyle default dsInherit;
  published
    property Alignment: TAlignment read FAlignment write SetAlignment default taLeftJustify;
    property BGColor : TIWColor read GetBGColor write SetBGColor default clNone;
    property Font;
    property NoWrap: Boolean read FNoWrap write FNoWrap default False;
    property ConvertSpaces: Boolean read FConvertSpaces write FConvertSpaces default False;
    //Summary: ForControl determines which control this label is the label for.
    //  This should be set in accessible applications.
    property ForControl: TIWCustomControl read FForControl write SetForControl;
    //Summary: If HasTabOrder is set to true, then the Label will have a tab stop.
    //  This is useful for accessible applications.
    property HasTabOrder: Boolean read get_HasTabOrder write SetHasTabOrder;
  end;

  {$include IWPlatformAttrib.inc}
  TIWLabel = class(TIWCustomLabel)
  published
    property AutoSize;
    property FriendlyName;

    property Caption;
    property RawText default False;
    property DisplayStyle;

    // property AsyncServerProcess;
    property OnAsyncClick;
    property OnAsyncMouseDown;
    property OnAsyncMouseMove;
    property OnAsyncMouseOver;
    property OnAsyncMouseOut;
    property OnAsyncMouseUp;
  end;

  {$include IWPlatformAttrib.inc}
  TIWLabelEx = class(TIWLabel)
  protected
    FImage: TIWControlImage;
    procedure ImageChanged(Sender: TObject);
    procedure InitControl; override;
    procedure Dispose(ADispose: Boolean); override;
    procedure SetImage(const Value: TIWControlImage);
  published
    property Image: TIWControlImage read FImage write SetImage;
  public
    function RenderHTML(AContext: TIWCompContext): TIWHTMLTag; override;
    function RenderAsync(AContext: TIWCompContext): TIWXMLTag; override;
  end;

implementation
