unit IWCompRadioButton;
{$I IWCompilerDefines.inc}

{PUBDIST}

interface

uses
  Classes, Windows, IWVCLBaseControl, IWHTMLTag, IWXMLTag,
  IWControl, IWTypes, IWScriptEvents, IWRenderContext, IWBaseInterfaces,
  IWHTML40Interfaces;

type
  TIWCustomRadioButton = class(TIWCustomControl, IIWInputControl, IIWSubmitControl, IIWInputControl40)
  private
    FRawText: Boolean;
    FDisplayStyle: TIWDisplayStyle;
    procedure SetRawText(const Value: Boolean);
    procedure SetDisplayStyle(const Value: TIWDisplayStyle);
  protected
    FSubmitParam: string;  
    FValue: string;
    FGroup: string;
    FChecked: Boolean;
    procedure HookEvents(AContext: TIWPageContext40; AScriptEvents: TIWScriptEvents); override;
    procedure Submit(const AValue: string); override;
    procedure SetValue(const AValue: string); virtual;
    procedure SetChecked(AValue: Boolean);
    procedure InitControl; override;
    procedure GetInputControlNames(ANames: TStringList); override;
    function IsForThisControl(AName: string): Boolean; override;
    procedure SetName(const AName: TComponentName); override;
    function getTabOrder: TIWTabOrder; override;
    procedure setTabOrder(AValue: TIWTabOrder); override;

    function RenderAsync(AContext: TIWCompContext): TIWXMLTag; override;
    function SupportsInput: Boolean; override;
    function get_HasName: Boolean; override;
  public
    function RenderHTML(AContext: TIWCompContext): TIWHTMLTag; override;
    function GetSubmitParam: string;
    function RenderStyle(AComponentContext: TIWCompContext): string; override;
    property Checked: Boolean read FChecked write SetChecked default False;
    property Group: string read FGroup write FGroup;
    property Value: string read FValue write FValue;
    property DisplayStyle: TIWDisplayStyle read FDisplayStyle write SetDisplayStyle default dsInherit;
  published
    property Caption;
    property Editable default True;
    property Enabled default True;
    property ExtraTagParams;
    property Font;
    property ScriptEvents;
    property DoSubmitValidation;
    property OnClick;
    property RawText: Boolean read FRawText write SetRawText;
  end;

  {$include IWPlatformAttrib.inc}
  TIWRadioButton = class(TIWCustomRadioButton)
  published
    property Editable;
    property Enabled;
    property Checked;
    property Group;
    property Value;
    property FriendlyName;
    property DisplayStyle;

    property SubmitOnAsyncEvent;
    property OnAsyncClick;
    property OnAsyncChange;
    property OnAsyncEnter;
    property OnAsyncExit;
    property OnAsyncKeyDown;
    property OnAsyncKeyUp;
    property OnAsyncKeyPress;
    property OnAsyncMouseDown;
    property OnAsyncMouseMove;
    property OnAsyncMouseOver;
    property OnAsyncMouseOut;
    property OnAsyncMouseUp;
  end;

implementation
