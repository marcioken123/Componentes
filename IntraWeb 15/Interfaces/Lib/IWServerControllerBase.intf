    procedure SetCookieOptions(const Value: TIWSessionCookieOptions);
    procedure SetSearchEngineOptions(const Value: TIWSearchEngineOptions);
    procedure SetJavaScriptOptions(const Value: TIWJavaScriptOptions);
    procedure SetSecurityOptions(const Value: TIWSecurityOptions);
    procedure SetBackButtonOptions(const Value: TIWBackButtonOptions);
    procedure SetMobileOptions(const Value: TIWMobileOptions);
    procedure SetProxyPortRedirection(const Value: TIWProxyPortRedirection);
    procedure SetTheme(const Value: string);
    procedure DoOnUserTag(const aName: string; aParams: TStrings; aOutput: TStringStream);
    procedure DoOnSessionTag(aSession: TIWApplication; const aName: string; aParams: TStrings; aOutput: TStringStream);
    procedure DoBrowserCheck(aSession: TIWApplication; var rBrowser: TBrowser);
    procedure SetUseAjaxNotify(const Value: Boolean);
    function RedirectPortString(const ARequest: THttpRequest; const aHttps: Boolean): string;
    procedure DownloadContentFile(const aUrl, aSubPath: string);
