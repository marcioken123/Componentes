    class procedure UnregisterExceptionCallback(aCallback: TIWExceptionCallbackProc);
    class property FixupPatchEnabled: Boolean read FFixupPatchEnabled write FFixupPatchEnabled;
    property ContentPath: string read fContentPath write SetContentPath;
    property Locked: boolean read mLocked;
    property StartDateTime: TDateTime read FStartDateTime;
    property StartUID: string read mStartUID;
    property GUIActive: Boolean read FGUIActive;
    property LicenseTracking: Boolean read FLicenseTracking write FLicenseTracking;
    property MachineName: string read mMachineName;
    property ProcessID: string read FProcessID;
    property CacheFiles: TIWMinStringList read mCacheFiles;
    property ServerVariables: TStringList read mServerVariables;
    property RewriteURL: string read mRewriteURL write mRewriteURL;
    property CheckWindowId: Boolean read GetCheckWindowId;
    // List of document extensions which should be blocked right when receiving the request on IWServer.
    // Received URLs will be checked against this list and they will be blocked if the URL address ends with
    // anything on that list (404 is returned to the caller).
    // For insance, any document path terminated with '.php' will be blocked by default
    // because several attacks try to explore common known .php documents. This avoids the
    // costy creation/initialization/destruction of new sessions
    property BlockedDocExtensions: TIWMinStringList read FBlockedDocExtensions;
    property BlockedPathInfoList: TIWMinStringList read FBlockedPathInfoList;
    property RenderAsyncEnabled: Boolean read FRenderAsyncEnabled write FRenderAsyncEnabled default True;
    property UserSessionOldDestroyOrder: Boolean read FUserSessionOldDestroyOrder write FUserSessionOldDestroyOrder default False;
    property ShutdownStarted: Boolean read FShutdownStarted;
  published
    // Deprecated 14.0.1 2012-05-05
    property CharSet: string write SetDummyStr;
    //Deprecated: XII 2011-11-22
    property CacheExpiry: Integer write SetDummyInt;
    // Deprected 14.0.1 2012-05-05
    property FilesDir: string write SetDummyStr;
    // Deprected 14.0.26 2014-03-18
    property HistoryEnabled: Boolean write SetDummyBool;
    // Deprecated 14.0.1 2012-05-05
    property InternalFilesDir: string write SetDummyStr;
    // Deprecated 14.0.1 2012-05-05
    property InternalFilesURL: string write SetDummyStr;
    // Deprecated 14.0.13 2013-07-05. Use JavaScriptOptions instead
    property JavascriptDebug: Boolean write SetDummyBool;
    // Deprecated 14.0.53 2016-05-09. Not used anymore
    property RedirectMsgDelay: Integer write SetDummyInt;
    // Deprecated 14.0.1 2012-05-05
    property UseInternalFiles: Boolean write SetDummyBool;
    // Deprecated 15.1.0 2018-12-08
    property EnableImageToolbar: Boolean write SetDummyBool;
    // Depreacated 15.2.51 2022-03-06
    property LogSessionEvents: Boolean write SetLogSessionEvents;
