    procedure InitDesignTime; override;
    procedure SetContentFiles(const Value: TStringList);
    procedure InitControl; override;
  public
    RegionalSettings: TIWRegionalSettings;  // TIWRegionalSettings is a record. Expose it as a public member once props can't be used
    function AuthActive: Boolean;
    constructor Create(AOwner: TComponent); overload; override;
    constructor Create(const aConfigLog: Boolean); reintroduce; overload;
    // This is here because CB requires a constructor of this form in the immediate ancestor
    // to avoid other problems.
    constructor CreateNew(AOwner: TComponent; Dummy: Integer = 0); override;
    destructor Destroy; override;
    procedure BeforeDestruction; override;
    procedure AfterConstruction; override;

    class function IsHTTPS(ARequest: THttpRequest; ATestProxy: Boolean = False): Boolean;
    class procedure CheckLockGlobal(const aPropName: string);
