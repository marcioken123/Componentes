    property AuthBeforeNewSession: Boolean read FAuthBeforeNewSession write FAuthBeforeNewSession default False;
    property AppName: string read FAppName write SetAppName;
    property BoundIP: string read FBoundIP write SetBoundIP;
    property CacheDir: string read mCacheDir write SetCacheDir;
    property ComInitialization: TComInitialization read FComInitialization write FComInitialization default ciNone;
    property Compression: TIWCompressionOptions read FCompression write SetCompression;
    property Description: string read FDescription write FDescription;
    property DebugHTML: Boolean read FDebugHTML write FDebugHTML default False;
    property DisplayName: string read mDisplayName write mDisplayName;
    property Log: TLogOptions read FLog write FLog default loNone;
    property ExceptionDisplayMode: TIWShowMessageType read FExceptionDisplayMode write FExceptionDisplayMode default smAlert;
    property HTMLHeaders: TStringList read FHTMLHeaders write SetHTMLHeaders;
    property ContentFiles: TStringList read FContentFiles write SetContentFiles;
    property MasterTemplate:string read FMasterTemplate write FMasterTemplate;
    property PageTransitions: Boolean read FPageTransitions write FPageTransitions default False;
    property Port: Integer read FPort write FPort;
    property ServerResizeTimeout: Integer read FServerResizeTimeout write FServerResizeTimeout default 0;
    property Auther: TIWAutherBase read mAuther write SetAuther;
    ///Summary: If true then a small turning sparkle animation will be shown, while the application
    ///  is locked (loads).
    property ShowLoadingAnimation: Boolean write SetShowLoadingAnimation; // deprecated, write-only. Use LockerOptions instead
    property StyleSheet: TIWFileReference read FStyleSheet write SetStyleSheet;
    property SSLOptions: TIWSSLOptions read FSSLOptions write SetSSLOptions;
    property TemplateDir: string read FTemplateDir write SetTemplateDir;
    property Theme: string read FTheme write SetTheme;
    property URLBase: string read FURLBase write SetURLBase;
    property Version: string read GetVersion write SetVersion;
    property DocType: string read mDocType write SetDocType;
    property IECompatibilityMode: string read mIECompatibilityMode write mIECompatibilityMode;
    property ShowStartParams: boolean read mShowStartParams write mShowStartParams default True;
    property ExceptionLogger: TIWExceptionLogger read mExceptionLogger write SetExceptionLogger;
    property CookieOptions: TIWSessionCookieOptions read mCookieOptions write SetCookieOptions;
    property SearchEngineOptions: TIWSearchEngineOptions read mSearchEngineOptions write SetSearchEngineOptions;
    property JavaScriptOptions: TIWJavaScriptOptions read mJavaScriptOptions write SetJavaScriptOptions;
    property HttpKeepAlive: Boolean read mHttpKeepAlive write mHttpKeepAlive default False;
    property SecurityOptions: TIWSecurityOptions read mSecurityOptions write SetSecurityOptions;
    property LogCommandEnabled: Boolean read mLogCommandEnabled write mLogCommandEnabled default True;
    property BackButtonOptions: TIWBackButtonOptions read mBackButtonOptions write SetBackButtonOptions;
    property MobileOptions: TIWMobileOptions read mMobileOptions write SetMobileOptions;
    property ProxyPortRedirection: TIWProxyPortRedirection read mProxyPortRedirection write SetProxyPortRedirection;
    property UseAjaxNotify: Boolean read mUseAjaxNotify write SetUseAjaxNotify default True;
    property PostRedirectGet: TIWPostRedirectGetOption read mPostRedirectGet write mPostRedirectGet default prgDisabled;
    property CustomLockerAnimationFile: string write SetCustomLockerAnimationFile; // deprecated, write-only. Use LockerOptions instead
    property HTMLLanguage: string read mHtmlLanguage write SetHtmlLanguage;
    property HttpSysOptions: TIWHttpSysOptions read mHttpSysOptions write SetHttpSysOptions;
    property LoaderHTML: TStrings read mLoaderHTML write SetLoaderHTML;
    property SessionOptions: TIWSessionOptions read FSessionOptions write SetSessionOptions;
    // these properties are not part of SessionOptions. They are hidden from ObjectInspector (see IWRegister)
    property AllowMultipleSessionsPerUser: Boolean read GetAllowMultipleSessionsPerUser write SetAllowMultipleSessionsPerUser stored False;
    property SessionTimeout: Cardinal read GetSessionTimeout write SetSessionTimeout stored False;
    property LockSessionTimeout: Cardinal read GetLockSessionTimeout write SetLockSessionTimeout stored False;
    property RestartExpiredSession: Boolean read GetRestartExpiredSession write SetRestartExpiredSession stored False;
    property AutoLoadIniSettings: Boolean read FAutoLoadIniSettings write FAutoLoadIniSettings default True;
    // Events
    property OnAfterDispatch: TOnDispatch read FOnAfterDispatch write FOnAfterDispatch;
    property OnBeforeDispatch: TOnDispatch read FOnBeforeDispatch write FOnBeforeDispatch;
    property OnCloseSession: TOnCloseSessionEvent read FOnCloseSession write FOnCloseSession;
    property OnConfig: TNotifyEvent read mOnConfig write mOnConfig;
    property OnException: TOnExceptionEvent read FOnException write FOnException;
    property OnGetSessionID: TOnGetSessionID read FOnGetSessionID write FOnGetSessionID;
    property OnNewSession: TOnNewSessionEvent read mOnNewSession write mOnNewSession;
    property OnGetMainForm: TOnGetMainFormEvent read mOnGetMainForm write mOnGetMainForm;
    property OnBackButton: TOnBackButtonEvent read FOnBackButton write FOnBackButton;
    property OnBeforeRender:TOnBeforeRenderEvent read FOnBeforeRender write FOnBeforeRender;
    property OnAfterRender:TOnAfterRenderEvent read FOnAfterRender write FOnAfterRender;
    property OnUserTag: TOnUserTag read mOnUserTag write mOnUserTag;
    property OnSessionTag: TOnSessionTag read mOnSessionTag write mOnSessionTag;
    property OnBrowserCheck: TOnBrowserCheckEvent read mOnBrowserCheck write mOnBrowserCheck;
    property OnParseParameter: TOnParseParameterEvent read mOnParseParameter write mOnParseParameter;
    property OnSessionRestarted: TOnNewSessionEvent read mOnSessionRestarted write mOnSessionRestarted;
    property OnExecuteRequest: TOnExecuteRequest read mOnExecuteRequest write mOnExecuteRequest;
    property OnLogException: TOnLogExceptionEvent read mOnLogException write mOnLogException;
    property OnAuthFailed: TOnAuthFailed read mOnAuthFailed write mOnAuthFailed;
    property OnRewriteURL: TOnRewriteURLEvent read mOnRewriteURL write mOnRewriteURL;
    property OnBeforeNewSession: TOnBeforeNewSessionEvent read mOnBeforeNewSession write mOnBeforeNewSession;
    property OnBind: TOnBindEvent read mOnBind write mOnBind;
    property OnWindowIdChanged: TOnWindowIdChangedEvent read mOnWindowIdChanged write mOnWindowIdChanged;
    property OnValidateCacheFileAccess: TOnValidateCacheFileAccess read mOnValidateCacheFileAccess write mOnValidateCacheFileAccess;
    property OnMetaTag: TOnMetaTagEvent read mOnMetaTag write mOnMetaTag;
    property OnOAuthSuccess: TOnOAuthSuccessEvent read FOnOAuthSuccess write FOnOAuthSuccess;
    property OnOAuthError: TOnOAuthErrorEvent read FOnOAuthError write FOnOAuthError;
    property ThemeColor: string read mThemeColor write mThemeColor;
    property DisableTemplateCacheOnDebug: Boolean read FDisableTemplateCacheOnDebug write FDisableTemplateCacheOnDebug default True;
    property HttpClientClass: THttpClientClass read FHttpClientClass write FHttpClientClass default WinHttpClient;
    property LockerOptions: TIWLockerOptions read mLockerOptions write SetLockerOptions;
    property ServerMonitorOptions: TIWServerMonitorOptions read mServerMonitorOptions write SetServerMonitorOptions;
    property IndyServerOptions: TIWIndyServerOptions read mIndyServerOptions write SetIndyServerOptions;
  end;

